# Miscellaneous parameters
#_______________________________________________________________________

# Random number seed
bmx.seed = 43343 #21893

#_______________________________________________________________________
# Solver settings

amrex.fpe_trap_invalid = 1

#! Fluid solver
#!-----------------------------------------------------------//

bmx.fixed_dt = 0.25

bmx.max_step = 10

dem.solve = bacteria
bmx.particle_init_type = "AsciiFile"

bmx.verbose = 0

#
#_______________________________________________________________________
# Deposition scheme
bmx.cnc_deposition_scheme = one_to_one # trilinear # one_to_one
bmx.vf_deposition_scheme = one_to_one # trilinear # one_to_one

#_______________________________________________________________________
# Geometry / grids / tiles

# Maximum level in hierarchy
amr.max_level = 1

geometry.coord_sys   = 0                       # 0: Cartesian
geometry.is_periodic = 1       1       0       # Is periodic in each direction?
geometry.prob_lo     = 0.      0.      0.      # lo corner of physical domain
geometry.prob_hi     = 0.2000  0.2000  0.1000     # hi corner of physical domain

# Number of grid cells in each direction at the coarsest level
amr.n_cell =  16  16  8

bmx.tag_region    = true
bmx.tag_region_lo = 0. 0. 0.0500
bmx.tag_region_hi = 0.2000 0.2000 0.0875

# Don't put any buffer region around the tagged cells
amr.n_error_buf = 2

# Just require grid to be coarsenable by 2
amr.blocking_factor = 2

#! Grids
#!-----------------------------------------------------------//
# Maximum allowable size of each fluid subdomain in the problem domain;

# Fluid
amr.max_grid_size_x = 64
amr.max_grid_size_y = 64
amr.max_grid_size_z = 64

#! Tiles
#!-----------------------------------------------------------//

# Fluid: Maximum tile size within each grid
fabarray.mfiter_tile_size = 1024 1024 1024

# Particles: Maximum particle tile size
particles.input_file = "../fungi/fungi_init_cfg.dat"
particles.tile_size = 1024 1024 1024

#_______________________________________________________________________
# Particle load balancing
#bmx.load_balance_type = "KnapSack"

amr.dual_grid          = 0
amr.regrid_int         = -1

#! KnapSack settings
#!-----------------------------------------------------------//

#_______________________________________________________________________
# IO / Checkpointing

amr.par_ascii_int  = -1
amr.par_ascii_file ="vis"

amr.plot_int       = 1
amr.plot_file      ="plt"

amr.check_int      = -1
amr.check_file     ="chk"

#! Fluid model settings
#
fluid.solve = fluid
fluid.chem_species      = A B C D F
fluid.chem_species_diff = 6.0e-10 0.0 6.0e-10 6.0e-10 0.0
fluid.init_conc_species = 2.0e-5 0.0 2.0e-6 2.0e-5 0.0
fluid.surface_location = 0.0750
#_______________________________________________________________________
# Reaction model parameters
#
chem_species.max_vol = 1.0e-12
chem_species.seg_split_length = 30.0e-4
chem_species.max_seg_length = 35.0e-4
chem_species.max_seg_radius = 2.5e-4
chem_species.k1 = 2.0e-5
chem_species.kr1 = 2.0e-5
chem_species.k2 = 4.0
chem_species.kr2 = 0.0006
chem_species.k3 = 2.0e-5
chem_species.kr3 = 2.0e-5
chem_species.k4 = 2.0e-5
chem_species.kr4 = 2.0e-5
chem_species.k5 = 6000.0
chem_species.kr5 = 60.0
chem_species.k6 = 2.0e-5
chem_species.kr6 = 2.0e-5
chem_species.k7 = 2.0e-5
chem_species.kr7 = 2.0e-5
chem_species.kg = 4.0
chem_species.kv = 40000.0
chem_species.kb = 4.0
chem_species.kbv = 4000.0
chem_species.use_fba_growth = 1
chem_species.fba_debug = 1
chem_species.fba_sbml_file = "MODEL1604280024.xml"

chem_species.mass_transfer_A = 2.0e-5
chem_species.mass_transfer_B = 2.0e-5
chem_species.mass_transfer_C = 2.0e-5

chem_species.branching_probability = 0.0000
chem_species.splitting_probability = 0.2
chem_species.fusion_probability = 0.01
chem_species.max_fusion_separation = 6.0e-4
chem_species.rg_frequency = 200
chem_species.density_profile_bins = 50
chem_species.density_profile_maximum = 0.075

bmx.substeps = 4

#_______________________________________________________________________
# Cell force parameters
#
cell_force.fungi_stiffness = 1.0e6
cell_force.fungi_wall_stiffness = 1.0e5
cell_force.cell_stiffness = 1.0e6
cell_force.cell_wall_stiffness = 1.0e6

cell_force.fungi_boundary_width = 1.0e-4
cell_force.fungi_wall_boundary_width = 1.0e-04
cell_force.cell_boundary_width = 1.0e-5
cell_force.cell_wall_boundary_width = 1.0e-04

cell_force.neighbor_width = 6.25e-3

cell_force.bond_strength = 1.0
cell_force.bond_cutoff = 5.0e-4
cell_force.viscous_drag = 200.0
cell_force.gravity = 0.01
cell_force.fluctuation_scale = 4.0e-5
cell_force.fluctuation_mixing = 0.1
